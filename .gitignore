# Secure HID Pro Micro - Git Ignore

# ===== CRITICAL: NEVER COMMIT SECRETS =====
.env
.env.local
.env.backup
*.env

# Build artifacts (may contain plaintext during build)
build/
build_temp/
.arduino/
*.hex
*.elf
*.elf.map
*.eep
*.o
*.a
*.lst
*.sym
*.lss
*.map

# Generated secrets header (auto-generated from .env)
secrets.h

# Temporary files that may contain secrets
/tmp/secret*
/tmp/*key*
.secrets/
*.tmp
*.log
*.cache

# Arduino IDE build cache
.vscode/
*.code-workspace

# Python virtual environment
.venv/
venv/
__pycache__/
*.pyc

# OS-specific files
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Only safe files remain:
# - Source .ino files (no secrets)
# - Build/upload scripts (safe logic)
# - encrypt_secrets.py (safe logic)
# - README.md, .gitignore, .env.template
