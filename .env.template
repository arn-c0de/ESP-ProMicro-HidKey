# Secure HID Pro Micro - Environment Configuration Template
# Copy this file to .env and fill in your actual secrets
# WARNING: .env is in .gitignore - NEVER commit it to version control

# Main device password (will be encrypted at build time)
DEVICE_SECRET="YourMainPassword123!"

# Secondary password for multi-password support
DEVICE_SECRET_2="AlternativePassword456!"

# Fake password for duress scenarios (looks real but wrong)
FAKE_PASSWORD="WrongPassword789!"

# Key Derivation Function salt (non-secret, can be public)
# Used with device signature to derive encryption key
KDF_SALT="ProMicro2026SaltConstant"

# Build configuration
BUILD_ENCRYPTION_ENABLED=true

# Instructions:
# 1. Copy this file: cp .env.template .env
# 2. Edit .env with your actual passwords
# 3. Run ./build.sh to encrypt and compile
# 4. Run ./upload.sh to flash securely
# 5. After build, .env is PRESERVED by default; edit or delete manually if you want to remove secrets
