# Example Configuration for ESP-ProMicro-HidKey
# Copy this file to .env and customize with your passwords

# Number of password combinations
COMBINATION_COUNT=3

# AES-128 Master Key (32 hex characters = 16 bytes)
# Generate a random key with: python3 -c "import secrets; print(secrets.token_hex(16))"
# This key will be combined with a device-specific ID for encryption
AES_MASTER_KEY=0123456789ABCDEF0123456789ABCDEF

# Combination 0: short, short, long, short -> "admin123"
COMBINATION_0_SEQUENCE="0,0,1,0"
COMBINATION_0_PASSWORD="admin123"

# Combination 1: long, short, short -> "user456"
COMBINATION_1_SEQUENCE="1,0,0"
COMBINATION_1_PASSWORD="user456"

# Combination 2: short, long, long, short, long -> "password789"
COMBINATION_2_SEQUENCE="0,1,1,0,1"
COMBINATION_2_PASSWORD="password789"

# Sequence Format:
#   0 = Short button press (< 500ms)
#   1 = Long button press (>= 500ms)
#   Maximum length: 20 presses
#   Separate with commas, no spaces recommended
#
# Password Format:
#   Any ASCII text, max 63 characters
#   Will be XOR-encoded in generated header
#
# To add more combinations:
#   1. Increment COMBINATION_COUNT
#   2. Add COMBINATION_N_SEQUENCE and COMBINATION_N_PASSWORD
#   3. Run ./build.sh
# How many milliseconds of inactivity before the device recognizes the sequence
SEQUENCE_TIMEOUT_MS=5000  # milliseconds of inactivity before sequence recognition