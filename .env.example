# Example Configuration for ESP-ProMicro-HidKey
# Copy this file to .env and customize with your secrets

# Number of configured combinations
COMBINATION_COUNT=3

# AES-128 Master Key (32 hex characters = 16 bytes)
# Generate a random key with: python3 -c "import secrets; print(secrets.token_hex(16))"
# This key is used to AES-encrypt every configured secret before it is embedded
AES_MASTER_KEY=0123456789ABCDEF0123456789ABCDEF

# Combination 0: short, short, long, short -> regular password
COMBINATION_0_SEQUENCE="0,0,1,0"
COMBINATION_0_TYPE="text"
COMBINATION_0_PASSWORD="admin123"

# Combination 1: long, short, short -> another inline text secret
COMBINATION_1_SEQUENCE="1,0,0"
COMBINATION_1_TYPE="text"
COMBINATION_1_SECRET="user456"

# Combination 2: short, long, long, short, long -> ASCII-armored GPG private key from file
COMBINATION_2_SEQUENCE="0,1,1,0,1"
COMBINATION_2_TYPE="gpg-private-key"
COMBINATION_2_GPG_PRIVATE_KEY_FILE="./secrets/private-message-key.asc"

# Combination 3: short, short, long -> same GPG key stored directly in .env
# The actual key is inside COMBINATION_3_SECRET with escaped \n line breaks
COMBINATION_3_SEQUENCE="0,0,1"
COMBINATION_3_TYPE="gpg-private-key"
COMBINATION_3_SECRET="-----BEGIN PGP PRIVATE KEY BLOCK-----\n...\n-----END PGP PRIVATE KEY BLOCK-----\n"

# Sequence Format:
#   0 = Short button press (< 500ms)
#   1 = Long button press (>= 500ms)
#   Maximum length: 20 presses
#   Separate with commas, no spaces recommended
#
# Secret Format:
#   COMBINATION_N_TYPE=text
#     Use COMBINATION_N_PASSWORD or COMBINATION_N_SECRET
#   COMBINATION_N_TYPE=gpg-private-key
#     Prefer COMBINATION_N_GPG_PRIVATE_KEY_FILE or COMBINATION_N_SECRET_FILE
#   Escaped \\n in COMBINATION_N_SECRET become real line breaks
#   GPG private keys are normalized to Unix line endings and terminated with a final newline
#
# To add more combinations:
#   1. Increment COMBINATION_COUNT
#   2. Add COMBINATION_N_SEQUENCE and matching COMBINATION_N_TYPE
#   3. Add the secret itself as *_PASSWORD, *_SECRET or *_SECRET_FILE
#   4. Run ./build.sh
#
# Important:
#   The Pro Micro types data via USB keyboard emulation.
#   Very large armored keys are possible in flash, but typing them takes time.
#   Test imports in your target application before relying on them.
# How many milliseconds of inactivity before the device recognizes the sequence
SEQUENCE_TIMEOUT_MS=1000  # milliseconds of inactivity before sequence recognition
